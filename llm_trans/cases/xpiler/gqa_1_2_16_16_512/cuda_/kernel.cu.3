#include <cuda_fp16.h>
#include <mma.h>

using namespace nvcuda;

#define BLOCK_M 16
#define BLOCK_N 16
#define BLOCK_K 16

#define BATCH 1
#define HEAD 2
#define SEQ_Q 16
#define SEQ_KV 512
#define HEAD_DIM 16

// kernel: O = softmax(Q @ K) @ V
__global__ void _cuda_kernel_impl(const half *__restrict__ Q, const half *__restrict__ K,
                    const half *__restrict__ V, half *__restrict__ O) {
  int batch = blockIdx.z;
  int tile_row = blockIdx.x;
  int row0 = tile_row * BLOCK_M;
  if (row0 >= SEQ_Q) return;
  int rows_valid = BLOCK_M;
  if (row0 + rows_valid > SEQ_Q) rows_valid = SEQ_Q - row0;

  // Shared memory: float scores; half probabilities
  __shared__ float attn_tile[BLOCK_M * SEQ_KV];
  __shared__ half softmax_tile[BLOCK_M * SEQ_KV];

  const half *q_base = Q + (batch * SEQ_Q + row0) * HEAD_DIM;
  const half *k_base = K + (batch * SEQ_KV) * HEAD_DIM;

  for (int col = 0; col < SEQ_KV; col += BLOCK_N) {
    wmma::fragment<wmma::matrix_a, BLOCK_M, BLOCK_N, BLOCK_K, half,
                   wmma::row_major>
        q_frag;
    wmma::fragment<wmma::matrix_b, BLOCK_M, BLOCK_N, BLOCK_K, half,
                   wmma::col_major>
        k_frag;
    wmma::fragment<wmma::accumulator, BLOCK_M, BLOCK_N, BLOCK_K, float> s_frag;

    wmma::fill_fragment(s_frag, 0.0f);

    for (int k = 0; k < HEAD_DIM; k += BLOCK_K) {
      wmma::load_matrix_sync(q_frag, q_base + k, HEAD_DIM);
      wmma::load_matrix_sync(k_frag, k_base + col * HEAD_DIM + k, HEAD_DIM);
      wmma::mma_sync(s_frag, q_frag, k_frag, s_frag);
    }

    wmma::store_matrix_sync(attn_tile + /*local row offset*/ 0 * SEQ_KV + col, s_frag, SEQ_KV,
                            wmma::mem_row_major);
  }

  __syncthreads();

  for (int i = 0; i < rows_valid; ++i) {
    float max_val = -1e30f;
    for (int j = 0; j < SEQ_KV; ++j) {
      float v = attn_tile[i * SEQ_KV + j];
      max_val = fmaxf(max_val, v);
    }

    float sum_val = 0.0f;
    for (int j = 0; j < SEQ_KV; ++j) {
      float e = expf(attn_tile[i * SEQ_KV + j] - max_val);
      softmax_tile[i * SEQ_KV + j] = __float2half(e);
      sum_val += e;
    }
    float inv_sum = 1.0f / sum_val;
    for (int j = 0; j < SEQ_KV; ++j) {
      float p = __half2float(softmax_tile[i * SEQ_KV + j]) * inv_sum;
      softmax_tile[i * SEQ_KV + j] = __float2half(p);
    }
  }

  __syncthreads();

  wmma::fragment<wmma::matrix_a, BLOCK_M, BLOCK_N, BLOCK_K, half,
                 wmma::row_major>
      s_frag;
  wmma::fragment<wmma::matrix_b, BLOCK_M, BLOCK_N, BLOCK_K, half,
                 wmma::row_major>
      v_frag;
  wmma::fragment<wmma::accumulator, BLOCK_M, BLOCK_N, BLOCK_K, float> o_frag;

  wmma::fill_fragment(o_frag, 0.0f);

  const half *s_ptr = softmax_tile + 0 * SEQ_KV;
  const half *v_base = V + (batch * SEQ_KV) * HEAD_DIM;

  for (int k = 0; k < SEQ_KV; k += BLOCK_K) {
    wmma::load_matrix_sync(s_frag, s_ptr + k, SEQ_KV);
    wmma::load_matrix_sync(v_frag, v_base + k * HEAD_DIM, HEAD_DIM);
    wmma::mma_sync(o_frag, s_frag, v_frag, o_frag);
  }

  // Store float output tile to float scratch (reuse attn_tile region for this row)
  float *out_ptr = attn_tile + 0 * HEAD_DIM;
  wmma::store_matrix_sync(out_ptr, o_frag, HEAD_DIM, wmma::mem_row_major);
  // Convert float scratch to half output
  for (int i = 0; i < rows_valid; ++i) {
    for (int j = 0; j < HEAD_DIM; ++j) {
      O[(batch * SEQ_Q + row0 + i) * HEAD_DIM + j] = __float2half(out_ptr[i * HEAD_DIM + j]);
    }
  }
}

extern "C" void cuda_kernel(half *Q, half *K, half *V, half *O, int batch,
                           int heads, int M, int K_dim, int N) {
  size_t q_sz = batch * heads * M * K_dim * sizeof(half);
  size_t k_sz = batch * heads * K_dim * N * sizeof(half);
  size_t v_sz = batch * heads * N * K_dim * sizeof(half);
  size_t o_sz = batch * heads * M * K_dim * sizeof(half);
  // Launch one block per row tile per (batch*head)
  dim3 grid((M + BLOCK_M - 1) / BLOCK_M, 1, batch * heads);
  dim3 block(32);
  _cuda_kernel_impl<<<grid, block>>>(Q, K, V, O);
}

