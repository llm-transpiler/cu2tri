#include <cuda_fp16.h>
#include <mma.h>

using namespace nvcuda;

#define BLOCK_M 16
#define BLOCK_N 16
#define BLOCK_K 16

#define BATCH 1
#define HEAD 2
#define SEQ_Q 16
#define SEQ_KV 512
#define HEAD_DIM 16

// kernel: O = softmax(Q @ K) @ V
__global__ void _cuda_kernel_impl(const half *__restrict__ Q, const half *__restrict__ K,
                    const half *__restrict__ V, half *__restrict__ O) {
  int bh = blockIdx.z;
  int batch = bh / HEAD;
  int head = bh % HEAD;
  int tile_row = blockIdx.x;

  // Shared memory for temp attention scores
  __shared__ half attn_tile[BLOCK_M * SEQ_KV];
  __shared__ half softmax_tile[BLOCK_M * SEQ_KV];

  // 1️⃣ 计算 S = Q @ K^T （完整列维度填充到 shared attn_tile）
  for (int row = 0; row < SEQ_Q; row += BLOCK_M) {
    const half *q_base = Q + ((batch * HEAD + head) * SEQ_Q + row) * HEAD_DIM;
    const half *k_base = K + ((batch * HEAD + head) * SEQ_KV) * HEAD_DIM;

    for (int col = 0; col < SEQ_KV; col += BLOCK_N) {
      wmma::fragment<wmma::matrix_a, BLOCK_M, BLOCK_N, BLOCK_K, half,
                     wmma::row_major>
          q_frag;
      wmma::fragment<wmma::matrix_b, BLOCK_M, BLOCK_N, BLOCK_K, half,
                     wmma::col_major>
          k_frag;
      wmma::fragment<wmma::accumulator, BLOCK_M, BLOCK_N, BLOCK_K, half> s_frag;

      wmma::fill_fragment(s_frag, 0.0f);

      for (int kk = 0; kk < HEAD_DIM; kk += BLOCK_K) {
        // Q tile: advance along K_dim
        wmma::load_matrix_sync(q_frag, q_base + kk, HEAD_DIM);
        // K tile: interpret K [N, D] row-major as col_major (KxN) with ld = HEAD_DIM
        // base element corresponds to (n=col, d=kk) => offset col*HEAD_DIM + kk
        wmma::load_matrix_sync(k_frag, k_base + col * HEAD_DIM + kk, HEAD_DIM);
        wmma::mma_sync(s_frag, q_frag, k_frag, s_frag);
      }

      // Apply scale 1/sqrt(D) before softmax and store to shared
      wmma::store_matrix_sync(attn_tile + row * SEQ_KV + col, s_frag, SEQ_KV,
                              wmma::mem_row_major);
    }
  }

  __syncthreads();

  // 2️⃣ softmax 按行归一化（float 累加，再存回 half）
  for (int i = 0; i < SEQ_Q; ++i) {
    float max_val = -1e30f;
    for (int j = 0; j < SEQ_KV; ++j) {
      float v = __half2float(attn_tile[i * SEQ_KV + j]) * (1.0f / sqrtf((float)HEAD_DIM));
      max_val = fmaxf(max_val, v);
    }

    float sum_val = 0.0f;
    for (int j = 0; j < SEQ_KV; ++j) {
      float e = expf(__half2float(attn_tile[i * SEQ_KV + j]) * (1.0f / sqrtf((float)HEAD_DIM)) - max_val);
      softmax_tile[i * SEQ_KV + j] = __float2half(e);
      sum_val += e;
    }
    float inv_sum = 1.0f / sum_val;
    for (int j = 0; j < SEQ_KV; ++j) {
      float p = __half2float(softmax_tile[i * SEQ_KV + j]) * inv_sum;
      softmax_tile[i * SEQ_KV + j] = __float2half(p);
    }
  }

  __syncthreads();

  for (int row = 0; row < SEQ_Q; row += BLOCK_M) {
    wmma::fragment<wmma::matrix_a, BLOCK_M, BLOCK_N, BLOCK_K, half,
                   wmma::row_major>
        s_frag;
    wmma::fragment<wmma::matrix_b, BLOCK_M, BLOCK_N, BLOCK_K, half,
                   wmma::row_major>
        v_frag;
    wmma::fragment<wmma::accumulator, BLOCK_M, BLOCK_N, BLOCK_K, half> o_frag;

    wmma::fill_fragment(o_frag, 0.0f);

    const half *s_ptr = softmax_tile + row * SEQ_KV;
    const half *v_base = V + ((batch * HEAD + head) * SEQ_KV) * HEAD_DIM;

    for (int k = 0; k < SEQ_KV; k += BLOCK_K) {
      wmma::load_matrix_sync(s_frag, s_ptr + k, SEQ_KV);
      // V is [N=SEQ_KV, D=HEAD_DIM] row-major; treat as row_major KxN with ld=HEAD_DIM
      // base at (krow=k, ncol=0) => offset k*HEAD_DIM
      wmma::load_matrix_sync(v_frag, v_base + k * HEAD_DIM, HEAD_DIM);
      wmma::mma_sync(o_frag, s_frag, v_frag, o_frag);
    }

    wmma::store_matrix_sync(O + ((batch * HEAD + head) * SEQ_Q + row) * HEAD_DIM,
                            o_frag, HEAD_DIM, wmma::mem_row_major);
  }
}

extern "C" void cuda_kernel(half *Q, half *K, half *V, half *O, int batch,
                           int heads, int M, int K_dim, int N) {
  size_t q_sz = batch * heads * M * K_dim * sizeof(half);
  size_t k_sz = batch * heads * K_dim * N * sizeof(half);
  size_t v_sz = batch * heads * N * K_dim * sizeof(half);
  size_t o_sz = batch * heads * M * K_dim * sizeof(half);
  // The kernel loops over full SEQ_Q and SEQ_KV internally; launch one block per (batch*head)
  dim3 grid(1, 1, batch * heads);
  dim3 block(32);
  _cuda_kernel_impl<<<grid, block>>>(Q, K, V, O);
}

