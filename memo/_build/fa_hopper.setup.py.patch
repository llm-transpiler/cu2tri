+FORCE_BUILD = os.getenv("FLASH_ATTENTION_FORCE_BUILD", "FALSE") == "TRUE"
+SKIP_CUDA_BUILD = os.getenv("FLASH_ATTENTION_SKIP_CUDA_BUILD", "FALSE") == "TRUE"
+# If TRUE, prefer the system-provided NVCC (e.g., CUDA 13 on the host) and do not
+# override PYTORCH_NVCC with a downloaded toolchain. This avoids version
+# mismatches between headers and compiler.
+USE_SYSTEM_NVCC = os.getenv("FLASH_ATTENTION_USE_SYSTEM_NVCC", "FALSE") == "TRUE"
+# For CI, we want the option to build with C++11 ABI since the nvcr images use C++11 ABI
+FORCE_CXX11_ABI = os.getenv("FLASH_ATTENTION_FORCE_CXX11_ABI", "FALSE") == "TRUE"
